@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-4">
    <div class="mb-4 text-white">
        <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
        <p class="mb-0">Last updated: October 2026</p>
    </div>

    <div class="card privacy-card mb-3">
        <div class="card-body">
            <h2 class="h5 fw-bold">What information I collect</h2>
            <p>When you register an account or order a service, the site stores only what is needed to process your order:</p>
            <ul>
                <li>Your username and email address</li>
                <li>Details of the services you order (service type, tier, description and price)</li>
            </ul>
        </div>
    </div>

    <div class="card privacy-card mb-3">
        <div class="card-body">
            <h2 class="h5 fw-bold">How I use it</h2>
            <p class="mb-0">Your data is used only to show your orders, contact you about them and improve the site. I do not sell or share your personal data with third parties.</p>
        </div>
    </div>

    <div class="card privacy-card mb-3">
        <div class="card-body">
            <h2 class="h5 fw-bold">Cookies</h2>
            <p class="mb-0">The site uses only necessary cookies: one to keep you logged in and one to protect forms from fake requests. There are no advertising or tracking cookies.</p>
        </div>
    </div>

    <div class="card privacy-card mb-3">
        <div class="card-body">
            <h2 class="h5 fw-bold">Your rights</h2>
            <p class="mb-0">You can view your data on your profile page at any time. If you want your account or orders to be deleted, just contact me.</p>
        </div>
    </div>

    <div class="card privacy-card">
        <div class="card-body">
            <h2 class="h5 fw-bold">Contact</h2>
            <p class="mb-0">If you have any questions about this policy, write to me through my GitHub profile <a href="https://github.com/Moxovina929" target="_blank">Moxovina929</a>.</p>
        </div>
    </div>
</div>
