@model IEnumerable<AboutMeWeb.Models.ServiceCatalogItemViewModel>
@using AboutMeWeb.Enums

@{
    ViewData["Title"] = "Services";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="display-5 fw-bold">Services</h1>
        <p class="text-secondary text-white">Explore available services and choose the right solution for your project.</p>
    </div>

    <div class="row mb-4">
        <div class="col-12 col-md-8 col-lg-6">
            <label for="serviceSearch" class="form-label text-white">Search services</label>
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true"></span>
                <input id="serviceSearch" type="search" class="form-control" placeholder="Type part of a service name..." autocomplete="off" />
                <button id="clearSearch" type="button" class="btn btn-outline-secondary text-white" disabled>Clear</button>
            </div>
        </div>
    </div>

    <p id="searchStatus" class="text-secondary small text-white" role="status" aria-live="polite"></p>

    <div id="serviceGrid" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var service in Model)
        {
            var image = service.ServiceType switch
            {
                ServiceType.GmodServer => "gmod.png",
                ServiceType.MinecraftServer => "minecraft.png",
                ServiceType.Website => "website.png",
                ServiceType.AiAgentIntegration => "ai.png",
                ServiceType.CustomApplication => "software.png",
                _ => "software.png"
            };

            <div class="col service-card-item" data-service-title="@service.Title">
                <article class="card h-100 shadow-sm border-0 service-catalog-card service-card-@service.ServiceType">
                    <img src="~/img/@image" class="card-img-top service-catalog-image" alt="@service.Title" loading="lazy" />
                    <div class="card-body d-flex flex-column p-4">
                        <div class="fs-1 mb-3" aria-hidden="true">@service.Icon</div>
                        <h2 class="h5 card-title fw-bold">@service.Title</h2>
                        <p class="card-text text-secondary">@service.Description</p>
                        <div class="mt-auto pt-3">
                            <p class="fw-semibold mb-3">From $@service.BasePrice.ToString("0.##")</p>
                            <a asp-controller="Services" asp-action="Create" asp-route-serviceType="@((int)service.ServiceType)" class="btn btn-primary w-100">Order service</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    <div id="noServicesFound" class="text-center text-secondary py-5 d-none">
        <h2 class="h5">No services found</h2>
        <p>Try a different search term.</p>
    </div>
</div>

<style>
    .service-catalog-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
        background: #20232b;
        color: #f1f3f5;
        border-top: 3px solid transparent !important;
    }

    .service-catalog-card .card-title {
        color: #fff;
    }

    .service-catalog-card .card-text {
        color: #c1c5ce !important;
    }

    .service-catalog-card:hover {
        transform: translateY(-4px);
    }

    .service-card-GmodServer {
        border-top-color: #d94b4b !important;
    }

        .service-card-GmodServer:hover {
            box-shadow: 0 0.75rem 1.5rem rgba(217, 75, 75, 0.2) !important;
        }

    .service-card-MinecraftServer {
        border-top-color: #2e6b35 !important;
    }

        .service-card-MinecraftServer:hover {
            box-shadow: 0 0.75rem 1.5rem rgba(85, 168, 90, 0.2) !important;
        }

    .service-card-Website {
        border-top-color: #438be8 !important;
    }

        .service-card-Website:hover {
            box-shadow: 0 0.75rem 1.5rem rgba(67, 139, 232, 0.2) !important;
        }

    .service-card-AiAgentIntegration {
        border-top-color: #a878ed !important;
    }

        .service-card-AiAgentIntegration:hover {
            box-shadow: 0 0.75rem 1.5rem rgba(168, 120, 237, 0.22) !important;
        }

    .service-card-CustomApplication {
        border-top-color: #e0a548 !important;
    }

        .service-card-CustomApplication:hover {
            box-shadow: 0 0.75rem 1.5rem rgba(224, 165, 72, 0.2) !important;
        }

    .service-catalog-image {
        width: 100%;
        height: 190px;
        object-fit: cover;
    }
</style>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById("serviceSearch");
            const clearButton = document.getElementById("clearSearch");
            const cards = Array.from(document.querySelectorAll(".service-card-item"));
            const status = document.getElementById("searchStatus");
            const noResults = document.getElementById("noServicesFound");

            function normalize(value) {
                return value.trim().toLocaleLowerCase();
            }

            function filterServices() {
                const query = normalize(searchInput.value);
                let visibleCount = 0;

                cards.forEach(card => {
                    const title = normalize(card.dataset.serviceTitle || "");
                    const matches = title.includes(query);

                    card.classList.toggle("d-none", !matches);

                    if (matches) {
                        visibleCount++;
                    }
                });

                noResults.classList.toggle("d-none", visibleCount !== 0);

                status.textContent = query
                    ? `${visibleCount} service(s) found`
                    : `${visibleCount} services available`;

                clearButton.disabled = searchInput.value.length === 0;
            }

            searchInput.addEventListener("input", filterServices);

            clearButton.addEventListener("click", () => {
                searchInput.value = "";
                filterServices();
                searchInput.focus();
            });

            filterServices();
        })();
    </script>
}
