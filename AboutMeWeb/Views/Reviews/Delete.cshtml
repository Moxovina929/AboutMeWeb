@model Review

@{
    ViewData["Title"] = "Delete review";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1>@ViewData["Title"]</h1>
        <p class="text-white">Are you sure you want to delete this review? This can't be undone.</p>

        <div class="review-card mb-3">
            <h2 class="h5">@Model.Service.Title</h2>
            <partial name="_Stars" model="Model.Rating" />
            <p class="mt-2 mb-0">@Model.Comment</p>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Mine" class="btn btn-outline-light ms-2">Cancel</a>
        </form>
    </div>
</div>
